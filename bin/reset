#!/usr/bin/env bash
# Tear the rig down to nothing and rebuild it from .env + docker-compose.yml.
#
#   bin/reset              # full: containers, volumes, install
#   bin/reset --images     # also rebuild this project's PHP image from scratch
#   bin/reset --db-only    # keep the vendor tree; wipe data and reinstall
#   bin/reset --no-sample-data
#   bin/reset --yes        # skip the confirmation prompt
#
# SCOPE: only ever touches this compose project. --images uses `--rmi local`,
# which removes images the project BUILT (modtest-php) and leaves pulled base
# images (mariadb, opensearch, nginx) alone — those are shared with other
# stacks on this machine. Nothing here prunes anything globally.
#
# This is the blunt instrument. Everything in the rig is reproducible from
# committed files, so when the install has drifted into a confusing state it is
# usually cheaper to rebuild than to diagnose. For routine tidying that does
# not cost 20 minutes, use bin/clean.
source "$(dirname "${BASH_SOURCE[0]}")/_bootstrap.sh"

DB_ONLY=0
ASSUME_YES=0
DROP_IMAGES=0
INSTALL_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --db-only) DB_ONLY=1 ;;
        --images) DROP_IMAGES=1 ;;
        --yes|-y) ASSUME_YES=1 ;;
        --no-sample-data) INSTALL_ARGS+=(--no-sample-data) ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

# Anything mounted in is about to be unmounted by the rebuild; read it from the
# registry so the instructions at the end can name them. (This used to scan for
# symlinks under app/code, which finds nothing now that modules are mounted.)
LINKED=()
if [ -s "$LINKED_REGISTRY" ]; then
    while read -r dir vendor name; do
        [ -z "${dir:-}" ] && continue
        LINKED+=("${dir} ${vendor} ${name}")
    done < "$LINKED_REGISTRY"
fi

echo "This will destroy:"
if [ "$DB_ONLY" -eq 1 ]; then
    echo "  - the database and search index (docker volumes)"
    echo "  - magento/app/etc/env.php (the install config)"
    echo "  - KEEPING magento/vendor, so the rebuild skips the download"
else
    echo "  - all containers and volumes (database, search index, composer cache)"
    echo "  - the entire magento/ tree ($(du -sh magento 2>/dev/null | cut -f1))"
    if [ "$DROP_IMAGES" -eq 1 ]; then
        echo "  - this project's built PHP image (rebuilt from the Dockerfile)"
        echo "    NOT touched: pulled base images (mariadb, opensearch, nginx),"
        echo "    which are shared with other stacks on this machine."
    fi
fi
if [ ${#LINKED[@]} -gt 0 ]; then
    echo
    echo "Linked modules (their own repos are NOT touched):"
    printf '  - %s\n' "${LINKED[@]}"
fi
echo
echo "Nothing outside ${PWD} is affected. Modules in ${MODULES_PATH} are safe."
echo

if [ "$ASSUME_YES" -eq 0 ]; then
    read -r -p "Type 'reset' to continue: " confirm
    [ "$confirm" = "reset" ] || { echo "Aborted."; exit 1; }
fi

echo
if [ "$DROP_IMAGES" -eq 1 ]; then
    echo "==> Stopping containers, removing volumes AND this project's built image"
    # --rmi local: only images this project built (no custom tag). Pulled base
    # images stay — they are shared with other stacks on this machine.
    docker compose down -v --remove-orphans --rmi local

    # Removing the image is not enough to re-execute the Dockerfile: BuildKit
    # still holds the layer cache and will restore a bit-identical image,
    # timestamp and all. --no-cache is what actually proves the build works
    # from scratch — which is the entire point of asking for --images.
    echo "==> Rebuilding the PHP image with --no-cache"
    docker compose build --no-cache php
else
    echo "==> Stopping containers and removing volumes"
    docker compose down -v --remove-orphans
fi

# Drop the module mounts for the rebuild. Leaving them in place would have
# Docker create mount points inside a magento/ tree that does not exist yet —
# as root — which breaks the install partway through with a permissions error.
# Modules are re-mounted at the end.
if [ -f docker-compose.override.yml ]; then
    echo "==> Removing module mounts for the rebuild"
    rm -f docker-compose.override.yml
fi

if [ "$DB_ONLY" -eq 1 ]; then
    echo "==> Removing install config, keeping vendor"
    rm -f magento/app/etc/env.php magento/app/etc/config.php
    rm -rf magento/var/cache/* magento/var/page_cache/* magento/generated/* \
           magento/pub/static/frontend/* magento/pub/static/adminhtml/* 2>/dev/null || true
else
    echo "==> Removing the magento tree"
    # Clear any legacy symlinks first so nothing can traverse into a module repo.
    # (Bind mounts were already dropped above with the override file.)
    find magento/app/code -mindepth 2 -maxdepth 2 -type l -delete 2>/dev/null || true
    rm -rf magento
    # bin/install recreates the project when it finds no composer.json, which
    # is the same path a fresh clone takes. One implementation, not two.
fi

echo "==> Installing"
./bin/install --force "${INSTALL_ARGS[@]}"

if [ ${#LINKED[@]} -gt 0 ]; then
    echo
    echo "==> Re-mounting the modules that were linked before the reset"
    for entry in "${LINKED[@]}"; do
        # shellcheck disable=SC2086
        set -- $entry
        echo "    ${2}_${3}"
        ./bin/link-module "$1" "$2" "$3" >/dev/null
        docker compose run --rm --user "$DC_USER" php \
            php bin/magento module:enable "${2}_${3}" >/dev/null 2>&1 || true
    done
    docker compose run --rm --user "$DC_USER" php php bin/magento setup:upgrade >/dev/null
    echo "    re-mounted and enabled; run bin/mage setup:di:compile if you need it"
fi
