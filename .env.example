# Copy to .env and adjust. `bin/install` does this for you if .env is missing.
#
# Ports are deliberately non-default so this stack can run alongside other local
# projects without fighting them for 80/3306/9200.

COMPOSE_PROJECT_NAME=modtest

# Versions
MAGEOS_VERSION=3.4.0
PHP_VERSION=8.4
MARIADB_VERSION=11.4
OPENSEARCH_VERSION=2.19.1
NGINX_VERSION=1.27

# Host ports
HTTP_PORT=8380
DB_PORT=33406
OPENSEARCH_PORT=9280

# Database (local throwaway credentials — this rig is not internet-facing)
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root

# Integration-test database. The Magento test framework OWNS this schema and
# drops/recreates it on every run — never point it at anything you care about.
DB_TEST_NAME=magento_integration_tests

# Storefront
BASE_URL=http://localhost:8380/
ADMIN_URL=admin
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com

# Locale of the generated store. Change before running bin/install; changing it
# afterwards requires a reinstall.
STORE_LANGUAGE=en_US
STORE_CURRENCY=GBP
STORE_TIMEZONE=Europe/London

# ---------------------------------------------------------------------------
# THE IMPORTANT ONE
# ---------------------------------------------------------------------------
# Absolute host path holding the modules under test. Bind-mounted at the SAME
# sides. bin/link-module bind-mounts each module from here into app/code.
# This is machine-specific — set it to wherever your modules live.
MODULES_PATH=/path/to/your/modules
